# Development Dockerfile - Hot Reload Enabled
FROM node:20-alpine

# Install watchman for better file watching
RUN apk add --no-cache watchman

WORKDIR /app

# Install the canonical root workspace graph.
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
COPY backend/prisma ./backend/prisma/
RUN npm ci

# Copy source code (will be mounted as volume)
COPY backend/ ./backend/
COPY frontend/ ./frontend/

# Generate Prisma client
RUN npm run prisma:generate --workspace=backend

# Default command - runs in development mode with tsx watch
CMD ["npm", "run", "dev", "--workspace=backend"]
