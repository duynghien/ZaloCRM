{
  "name": "zalo-sales-crm-backend",
  "version": "1.0.0",
  "description": "Zalo Sales CRM Backend API",
  "main": "dist/app.js",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "start": "node dist/app.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "ai:smoke": "tsx src/modules/ai-reports/gemini-model-smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@google/genai": "^2.20.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.4",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.1.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "zca-js": "^2.1.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.4",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  }
}
