  recentSends DateTime[]  @default([]) @map("recent_sends")
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at")

  account     ZaloAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("zalo_account_rate_state")
}

model ZaloOutboundMessage {
  id             String       @id @default(uuid())
  orgId          String       @map("org_id")
  accountId      String       @map("account_id")
  threadId       String       @map("thread_id")
  conversationId String?      @map("conversation_id")
  messageId      String?      @map("message_id")
  idempotencyKey String?      @map("idempotency_key")
  requestHash    String       @map("request_hash")
  content        String?
  attachments    Json?
  state          String       @default("preparing") // preparing, dispatching, succeeded, uncertain, failed_before_dispatch
  remoteMsgIds   String[]     @default([]) @map("remote_msg_ids")
  lastError      String?      @map("last_error")
