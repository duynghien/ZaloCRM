generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Top-level org — every resource is scoped to an org
model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teams              Team[]
  users              User[]
  zaloAccounts       ZaloAccount[]
  contacts           Contact[]
  conversations      Conversation[]
  appointments       Appointment[]
  activityLogs       ActivityLog[]
  dailyStats         DailyMessageStat[]
  settings           AppSetting[]
  orders             Order[]
  orderCodeCounters  OrderCodeCounter[]
  groupReportConfigs GroupReportConfig[]
  generatedReports   GeneratedReport[]
  reportJobs         AiReportJob[]
  reportResends      AiReportResend[]
  aiUsageLogs        AiUsageLog[]
  dailyAiStats       DailyAiUsageStat[]
  notifications      Notification[]
  kiotvietProducts   KiotvietProduct[]
  kiotvietSyncState  KiotvietSyncState?
  kiotvietRateLimitBuckets KiotvietRateLimitBucket[]
  kiotvietRetailerLeases   KiotvietRetailerLease[]
  kiotvietInvoiceJobs      KiotvietInvoiceJob[]
  orderItems               OrderItem[]
  zaloOutboundMessages     ZaloOutboundMessage[]
  aiKnowledgeRules         AiKnowledgeRule[]
  aiReportFeedbacks        AiReportFeedback[]

  @@map("organizations")
}

// Team groups within an organization
model Team {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users User[]

  @@map("teams")
}

// CRM user with role-based access
model User {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  teamId       String?  @map("team_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         String   @default("member") // owner, admin, member
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  org              Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team             Team?               @relation(fields: [teamId], references: [id])
  zaloAccounts     ZaloAccount[]
  zaloAccess       ZaloAccountAccess[]
  assignedContacts Contact[]           @relation("AssignedContacts")
  appointments     Appointment[]
  repliedMessages  Message[]           @relation("RepliedMessages")
  activityLogs     ActivityLog[]
  createdOrders    Order[]             @relation("CreatedOrders")
  createdReports   GeneratedReport[]   @relation("CreatedReports")
  reportJobs       AiReportJob[]       @relation("CreatedReportJobs")
  authSessions     AuthSession[]
  aiUsageLogs      AiUsageLog[]
  notifications         Notification[]
  createdKnowledgeRules AiKnowledgeRule[]   @relation("CreatedKnowledgeRules")
  aiReportFeedbacks     AiReportFeedback[]

  @@unique([orgId, id])
  @@map("users")
}

// Server-side refresh-session state. The opaque refresh credential is never
// stored: only its SHA-256 digest is persisted for single-use rotation.
model AuthSession {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  familyId            String    @map("family_id")
  refreshTokenHash    String    @unique @map("refresh_token_hash")
  expiresAt           DateTime  @map("expires_at")
  lastUsedAt          DateTime? @map("last_used_at")
  rotatedAt           DateTime? @map("rotated_at")
  replacedBySessionId String?   @map("replaced_by_session_id")
  revokedAt           DateTime? @map("revoked_at")
  revokedReason       String?   @map("revoked_reason")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// Zalo account linked to a user (one user may own multiple Zalo accounts)
model ZaloAccount {
  id              String    @id @default(uuid())
  orgId           String    @map("org_id")
  ownerUserId     String    @map("owner_user_id")
  zaloUid         String?   @unique @map("zalo_uid")
  displayName     String?   @map("display_name")
  avatarUrl       String?   @map("avatar_url")
  phone           String?
  status          String    @default("disconnected") // connected, disconnected, qr_pending
  branchTag       String?   @map("branch_tag")
  colorTag        String?   @map("color_tag")
  sessionData     Json?     @map("session_data")
  lastConnectedAt DateTime? @map("last_connected_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner         User                @relation(fields: [ownerUserId], references: [id])
  access        ZaloAccountAccess[]
  conversations Conversation[]
  dailyStats    DailyMessageStat[]
  rateState     ZaloAccountRateState?
  outboundMessages ZaloOutboundMessage[]

  @@unique([orgId, id])
  @@map("zalo_accounts")
}

// ACL: which users can access which Zalo accounts
model ZaloAccountAccess {
  id            String   @id @default(uuid())
  zaloAccountId String   @map("zalo_account_id")
  userId        String   @map("user_id")
  permission    String   @default("read") // read, chat, admin
  createdAt     DateTime @default(now()) @map("created_at")

  zaloAccount ZaloAccount @relation(fields: [zaloAccountId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([zaloAccountId, userId])
  @@map("zalo_account_access")
}

// CRM contact record — generic pipeline with status field
model Contact {
  id               String    @id @default(uuid())
  orgId            String    @map("org_id")
  zaloUid          String?   @map("zalo_uid")
  phone            String?
  email            String?   @map("email")
  fullName         String?   @map("full_name")
  avatarUrl        String?   @map("avatar_url")
  source           String?   // FB, TT, GT, CN, etc.
  sourceDate       DateTime? @map("source_date")
  firstContactDate DateTime? @map("first_contact_date")
  status           String?   @default("new") // new/contacted/interested/converted/lost
  nextAppointment  DateTime? @map("next_appointment")
  assignedUserId   String?   @map("assigned_user_id")
  notes            String?
  tags             Json      @default("[]")
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignedUser  User?          @relation("AssignedContacts", fields: [assignedUserId], references: [id])
  conversations Conversation[]
  appointments  Appointment[]
  orders        Order[]

  @@unique([orgId, zaloUid])
  @@unique([orgId, id])
  @@map("contacts")
}

// A chat thread between a Zalo account and a contact (or group)
model Conversation {
  id               String    @id @default(uuid())
  orgId            String    @map("org_id")
  zaloAccountId    String    @map("zalo_account_id")
  contactId        String?   @map("contact_id")
  threadType       String    @default("user") // user, group
  externalThreadId String?   @map("external_thread_id")
  lastMessageAt    DateTime? @map("last_message_at")
  unreadCount      Int       @default(0) @map("unread_count")
  isReplied        Boolean   @default(true) @map("is_replied")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  zaloAccount ZaloAccount  @relation(fields: [orgId, zaloAccountId], references: [orgId, id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [orgId, contactId], references: [orgId, id])
  messages    Message[]
  orders      Order[]

  @@unique([zaloAccountId, externalThreadId])
  @@unique([orgId, id])
  @@index([orgId, zaloAccountId])
  @@map("conversations")
}

// Individual message within a conversation
model Message {
  id              String    @id @default(uuid())
  conversationId  String    @map("conversation_id")
  zaloMsgId       String?   @map("zalo_msg_id")
  senderType      String    @map("sender_type") // self, contact
  senderUid       String?   @map("sender_uid")
  senderName      String?   @map("sender_name")
  content         String?
  contentType     String    @default("text") @map("content_type") // text, image, file, sticker, voice, video, link
  attachments     Json      @default("[]")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")
  sentAt          DateTime  @map("sent_at")
  repliedByUserId String?   @map("replied_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  repliedBy    User?        @relation("RepliedMessages", fields: [repliedByUserId], references: [id])

  @@unique([conversationId, zaloMsgId])
  @@index([attachments], type: Gin)
  @@map("messages")
}

// Appointment scheduled for a contact
model Appointment {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  contactId       String   @map("contact_id")
  assignedUserId  String?  @map("assigned_user_id")
  appointmentDate DateTime @map("appointment_date")
  appointmentTime String?  @map("appointment_time")
  type            String?
  status          String   @default("scheduled") // scheduled, completed, cancelled, no_show
  notes           String?
  reminderSent    Boolean  @default(false) @map("reminder_sent")
  createdAt       DateTime @default(now()) @map("created_at")

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [orgId, contactId], references: [orgId, id], onDelete: Cascade)
  assignedUser User?        @relation(fields: [orgId, assignedUserId], references: [orgId, id])

  @@map("appointments")
}

// Audit trail for user actions
model ActivityLog {
  id         String   @id @default(uuid())
  orgId      String   @map("org_id")
  userId     String?  @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

// Daily messaging statistics per user per Zalo account
model DailyMessageStat {
  id                String   @id @default(uuid())
  orgId             String   @map("org_id")
  userId            String   @map("user_id")
  zaloAccountId     String   @map("zalo_account_id")
  statDate          DateTime @map("stat_date") @db.Date
  messagesSent      Int      @default(0) @map("messages_sent")
  messagesReceived  Int      @default(0) @map("messages_received")
  messagesUnread    Int      @default(0) @map("messages_unread")
  messagesUnreplied Int      @default(0) @map("messages_unreplied")
  avgResponseTime   Int?     @map("avg_response_time_seconds")

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  zaloAccount ZaloAccount  @relation(fields: [zaloAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, zaloAccountId, statDate])
  @@map("daily_message_stats")
}

// Encrypted or plain key-value settings per org
model AppSetting {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  settingKey     String   @map("setting_key")
  valuePlain     String?  @map("value_plain")
  valueEncrypted Bytes?   @map("value_encrypted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, settingKey])
  @@map("app_settings")
}

// Sales order linked to a contact (and optionally a conversation)
model Order {
  id                  String    @id @default(uuid())
  orgId               String    @map("org_id")
  contactId           String    @map("contact_id")
  createdByUserId     String    @map("created_by_user_id")
  conversationId      String?   @map("conversation_id")
  orderCode           String    @map("order_code")
  totalAmount         Float     @map("total_amount")
  status              String    @default("new") // new, confirmed, paid, shipped, completed, cancelled
  notes               String?
  paidAmount          Decimal?  @map("paid_amount") @db.Decimal(18, 0)
  paymentMethod       String?   @map("payment_method")
  paymentAccountId    BigInt?   @map("payment_account_id")
  paymentRecordedAt   DateTime? @map("payment_recorded_at")
  kiotvietCustomerId  BigInt?   @map("kiotviet_customer_id")
  kiotvietInvoiceId   BigInt?   @map("kiotviet_invoice_id")
  kiotvietInvoiceCode String?   @map("kiotviet_invoice_code")
  kiotvietSyncStatus  String    @default("not_synced") @map("kiotviet_sync_status")
  kiotvietSyncError   String?   @map("kiotviet_sync_error")
  kiotvietSyncedAt    DateTime? @map("kiotviet_synced_at")
  revision            Int       @default(0)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact      Contact             @relation(fields: [orgId, contactId], references: [orgId, id], onDelete: Cascade)
  createdBy    User                @relation("CreatedOrders", fields: [orgId, createdByUserId], references: [orgId, id])
  conversation Conversation?       @relation(fields: [orgId, conversationId], references: [orgId, id])
  items        OrderItem[]
  kiotvietJob  KiotvietInvoiceJob?

  @@unique([orgId, orderCode])
  @@unique([orgId, id])
  @@map("orders")
}

// Configuration for which Zalo groups to monitor for AI Digest
model GroupReportConfig {
  id                     String   @id @default(uuid())
  orgId                  String   @map("org_id")
  groupThreadId          String   @map("group_thread_id")
  groupName              String?  @map("group_name")
  zaloAccountId          String?  @map("zalo_account_id")
  isEnabled              Boolean  @default(true) @map("is_enabled")
  targetResolutionStatus String   @default("resolved") @map("target_resolution_status")
  legacyTargetData       Json?    @map("legacy_target_data")
  customPrompt           String?  @map("custom_prompt")
  focusKeywords          Json     @default("[]") @map("focus_keywords")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, zaloAccountId, groupThreadId])
  @@map("group_report_configs")
}

// Generated AI executive reports / digests
model GeneratedReport {
  id                     String   @id @default(uuid())
  orgId                  String   @map("org_id")
  createdById            String?  @map("created_by_id")
  title                  String
  reportType             String   @default("on_demand") // daily, weekly, on_demand
  periodFrom             DateTime @map("period_from")
  periodTo               DateTime @map("period_to")
  groupThreadIds         Json     @default("[]") @map("group_thread_ids")
  sourceTargets          Json?    @map("source_targets")
  targetSchemaVersion    Int      @default(1) @map("target_schema_version")
  targetResolutionStatus String   @default("legacy_unverified") @map("target_resolution_status")
  summaryContent         String   @map("summary_content") @db.Text
  structuredData         Json     @default("{}") @map("structured_data")
  sentZalo               Boolean  @default(false) @map("sent_zalo")
  sentEmail              Boolean  @default(false) @map("sent_email")
  metadata               Json     @default("{}")
  createdAt              DateTime @default(now()) @map("created_at")

  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("CreatedReports", fields: [createdById], references: [id])
  job                  AiReportJob?        @relation("ResultReport")
  resends              AiReportResend[]
  sourceKnowledgeRules AiKnowledgeRule[]   @relation("SourceReportRules")
  reportFeedbacks      AiReportFeedback[]

  @@index([orgId, createdAt])
  @@map("generated_reports")
}

// Persistent, lease-claimed work for on-demand AI generation. Request data is
// a normalized snapshot so retries cannot silently change the requested scope.
model AiReportJob {
  id                      String    @id @default(uuid())
  orgId                   String    @map("org_id")
  createdById             String?   @map("created_by_id")
  idempotencyKey          String    @map("idempotency_key")
  scheduleKey             String?   @unique @map("schedule_key")
  status                  String    @default("queued")
  requestData             Json      @map("request_data")
  attempts                Int       @default(0)
  leaseOwner              String?   @map("lease_owner")
  leaseExpiresAt          DateTime? @map("lease_expires_at")
  cancellationRequestedAt DateTime? @map("cancellation_requested_at")
  resultReportId          String?   @unique @map("result_report_id")
  errorMessage            String?   @map("error_message")
  createdAt               DateTime  @default(now()) @map("created_at")
  startedAt               DateTime? @map("started_at")
  finishedAt              DateTime? @map("finished_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  org                Organization                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy          User?                       @relation("CreatedReportJobs", fields: [createdById], references: [id], onDelete: SetNull)
  resultReport       GeneratedReport?            @relation("ResultReport", fields: [resultReportId], references: [id], onDelete: SetNull)
  dispatches         AiReportJobDispatch[]
  budgetReservations AiReportBudgetReservation[]

  @@unique([orgId, createdById, idempotencyKey])
  @@index([status, leaseExpiresAt])
  @@index([orgId, status])
  @@map("ai_report_jobs")
}

model AiReportJobDispatch {
  id             String    @id @default(uuid())
  jobId          String    @map("job_id")
  channel        String
  status         String    @default("pending")
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  claimedAt      DateTime? @map("claimed_at")
  completedAt    DateTime? @map("completed_at")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  sentParts         Int     @default(0) @map("sent_parts")
  totalParts        Int?    @map("total_parts")
  deliveryUncertain Boolean @default(false) @map("delivery_uncertain")

  job AiReportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, channel])
  @@map("ai_report_job_dispatches")
}

// Each provider attempt retains its full reservation even after uncertain failure.
model AiReportBudgetReservation {
  id               String   @id @default(uuid())
  jobId            String   @map("job_id")
  attemptKey       String   @map("attempt_key")
  leaseOwner       String   @map("lease_owner")
  leaseExpiresAt   DateTime @map("lease_expires_at")
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  usedInputTokens  Int?     @map("used_input_tokens")
  usedOutputTokens Int?     @map("used_output_tokens")
  outcome          String   @default("reserved")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  job AiReportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptKey])
  @@map("ai_report_budget_reservations")
}

// Requester identity remains stable after user deletion for idempotency/audit.
model AiReportResend {
  id             String    @id @default(uuid())
  orgId          String    @map("org_id")
  requestedById  String    @map("requested_by_id")
  reportId       String    @map("report_id")
  idempotencyKey String    @map("idempotency_key")
  requestData    Json      @map("request_data")
  status         String    @default("pending")
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  org        Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  report     GeneratedReport          @relation(fields: [reportId], references: [id], onDelete: Restrict)
  dispatches AiReportResendDispatch[]

  @@unique([orgId, requestedById, idempotencyKey])
  @@index([orgId, reportId])
  @@map("ai_report_resends")
}

model AiReportResendDispatch {
  id                String    @id @default(uuid())
  resendId          String    @map("resend_id")
  channel           String
  status            String    @default("pending")
  leaseOwner        String?   @map("lease_owner")
  leaseExpiresAt    DateTime? @map("lease_expires_at")
  claimedAt         DateTime? @map("claimed_at")
  completedAt       DateTime? @map("completed_at")
  sentParts         Int       @default(0) @map("sent_parts")
  totalParts        Int?      @map("total_parts")
  deliveryUncertain Boolean   @default(false) @map("delivery_uncertain")
  errorMessage      String?   @map("error_message")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  resend AiReportResend @relation(fields: [resendId], references: [id], onDelete: Cascade)

  @@unique([resendId, channel])
  @@map("ai_report_resend_dispatches")
}

// Allocation participates in the order transaction; committed deletions never
// decrement the counter, so previously issued codes cannot be reused.
model OrderCodeCounter {
  orgId String @map("org_id")
  dateKey String @map("date_key")
  lastValue BigInt @default(0) @map("last_value")
  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, dateKey])
  @@map("order_code_counters")
}

model AiUsageLog {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  userId       String?  @map("user_id")
  taskType     String   @map("task_type") // 'copilot' | 'executive_report' | 'audit_rule' | 'vision_ocr' | 'test_connection'
  provider     String   // 'gemini' | 'openai' | 'deepseek' | 'custom'
  model        String
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  cachedTokens Int      @default(0) @map("cached_tokens")
  totalTokens  Int      @default(0) @map("total_tokens")
  costUsd      Float    @default(0) @map("cost_usd")
  costVnd      BigInt   @default(0) @map("cost_vnd")
  durationMs   Int?     @map("duration_ms")
  status       String   @default("success") // 'success' | 'failed'
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, taskType])
  @@map("ai_usage_logs")
}

model DailyAiUsageStat {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  statDate     DateTime @map("stat_date") @db.Date // UTC+7 normalized date
  taskType     String   @map("task_type")
  provider     String
  model        String
  requestCount Int      @default(1) @map("request_count")
  inputTokens  BigInt   @default(0) @map("input_tokens")
  outputTokens BigInt   @default(0) @map("output_tokens")
  cachedTokens BigInt   @default(0) @map("cached_tokens")
  totalTokens  BigInt   @default(0) @map("total_tokens")
  costUsd      Float    @default(0) @map("cost_usd")
  costVnd      BigInt   @default(0) @map("cost_vnd")
  updatedAt    DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, statDate, taskType, provider, model], name: "org_date_task_provider_model_unique")
  @@index([orgId, statDate])
  @@map("daily_ai_usage_stats")
}

// Persistent notification with read-state tracking (Team-Acknowledged model for org-wide alerts)
model Notification {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  userId      String?   @map("user_id")
  targetRole  String?   @map("target_role") // 'owner' | 'admin' | 'manager' (null = all members)
  entityType  String?   @map("entity_type") // 'conversation' | 'zalo_account' | 'appointment'
  entityId    String?   @map("entity_id")   // ID for automatic resolution hooks
  dedupKey    String?   @map("dedup_key")   // Concurrency-safe deduplication key
  type        String    // 'info' | 'warning' | 'error' | 'success' | 'ai_alert'
  category    String    // 'appointment' | 'chat_sla' | 'zalo_account' | 'copilot' | 'system'
  title       String
  detail      String
  actionUrl   String?   @map("action_url")
  priority    String    @default("medium") // 'low' | 'medium' | 'high' | 'urgent'
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, orgId])
  @@unique([orgId, dedupKey])
  @@index([orgId, userId, isRead, createdAt])
  @@index([orgId, isRead, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

// Order line item snapshot
model OrderItem {
  id                String   @id @default(uuid())
  orgId             String   @map("org_id")
  orderId           String   @map("order_id")
  productId         String?  @map("product_id")
  kiotvietProductId BigInt   @map("kiotviet_product_id")
  retailer          String
  branchId          BigInt   @map("branch_id")
  productCode       String   @map("product_code")
  productName       String   @map("product_name")
  unit              String?
  quantity          Decimal  @db.Decimal(18, 3)
  price             Decimal  @db.Decimal(18, 4)
  discountMode      String   @default("amount") @map("discount_mode")
  discountInput     Decimal  @default(0) @map("discount_input") @db.Decimal(18, 4)
  discountAmount    Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 4)
  subtotal          Decimal  @db.Decimal(18, 0)
  note              String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  order Order        @relation(fields: [orgId, orderId], references: [orgId, id], onDelete: Cascade)

  @@index([orgId, orderId])
  @@map("order_items")
}

// Local cache of KiotViet product catalog partitioned by (orgId, retailer, branchId)
model KiotvietProduct {
  id               String    @id @default(uuid())
  orgId            String    @map("org_id")
  retailer         String
  branchId         BigInt    @map("branch_id")
  kiotvietId       BigInt    @map("kiotviet_id")
  code             String
  name             String
  unit             String?
  price            Decimal   @db.Decimal(18, 4)
  onHand           Decimal?  @map("on_hand") @db.Decimal(18, 3)
  isActive         Boolean   @default(true) @map("is_active")
  allowsSale       Boolean   @default(true) @map("allows_sale")
  productType      String    @default("normal") @map("product_type")
  hasVariants      Boolean   @default(false) @map("has_variants")
  hasSerial        Boolean   @default(false) @map("has_serial")
  hasBatch         Boolean   @default(false) @map("has_batch")
  isMaster         Boolean   @default(false) @map("is_master")
  sourceModifiedAt DateTime? @map("source_modified_at")
  lastSeenRunId    String?   @map("last_seen_run_id")
  stockCheckedAt   DateTime? @map("stock_checked_at")
  rawAttributes    Json?     @map("raw_attributes")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, retailer, branchId, kiotvietId])
  @@index([orgId, retailer, branchId, isActive])
  @@index([orgId, retailer, code])
  @@index([orgId, retailer, name])
  @@map("kiotviet_products")
}

// Persistent sync state per organization
model KiotvietSyncState {
  orgId               String    @id @map("org_id")
  configRevision      Int       @default(0) @map("config_revision")
  retailer            String?
  branchId            BigInt?   @map("branch_id")
  catalogCursor       DateTime? @map("catalog_cursor")
  catalogReady        Boolean   @default(false) @map("catalog_ready")
  lastSuccessfulAt    DateTime? @map("last_successful_at")
  lastSuccessfulRunId String?   @map("last_successful_run_id")
  runId               String?   @map("run_id")
  runMode             String?   @map("run_mode")
  status              String    @default("idle")
  processedCount      Int       @default(0) @map("processed_count")
  totalProducts       Int       @default(0) @map("total_products")
  error               String?
  leaseOwner          String?   @map("lease_owner")
  leaseExpiresAt      DateTime? @map("lease_expires_at")
  leaseVersion        Int       @default(0) @map("lease_version")
  attemptCount        Int       @default(0) @map("attempt_count")
  nextAttemptAt       DateTime? @map("next_attempt_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("kiotviet_sync_states")
}

// Tenant-scoped rate limit bucket for KiotViet API quota
model KiotvietRateLimitBucket {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  retailer     String
  windowStart  DateTime  @map("window_start")
  requestCount Int       @default(0) @map("request_count")
  blockedUntil DateTime? @map("blocked_until")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, retailer, windowStart])
  @@map("kiotviet_rate_limit_buckets")
}

// Tenant-scoped lease per retailer to avoid cross-tenant DoS
model KiotvietRetailerLease {
  orgId          String    @map("org_id")
  retailer       String
  leaseOwner     String?   @map("lease_owner")
  leaseVersion   Int       @default(0) @map("lease_version")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, retailer])
  @@map("kiotviet_retailer_leases")
}

// Durable KiotViet invoice outbox job with claim, lease, fence and reconciliation support
model KiotvietInvoiceJob {
  id                   String    @id @default(uuid())
  orgId                String    @map("org_id")
  orderId              String    @map("order_id")
  orderRevision        Int       @map("order_revision")
  configRevision       Int       @map("config_revision")
  retailer             String
  branchId             BigInt    @map("branch_id")
  snapshot             Json
  snapshotHash         String    @map("snapshot_hash")
  state                String    @default("queued") // queued, preparing, dispatching, succeeded, failed, uncertain
  attemptCount         Int       @default(0) @map("attempt_count")
  nextAttemptAt        DateTime? @map("next_attempt_at")
  leaseOwner           String?   @map("lease_owner")
  leaseVersion         Int       @default(0) @map("lease_version")
  leaseExpiresAt       DateTime? @map("lease_expires_at")
  requestStartedAt     DateTime? @map("request_started_at")
  remoteInvoiceId      BigInt?   @map("remote_invoice_id")
  remoteInvoiceCode    String?   @map("remote_invoice_code")
  remoteSnapshot       Json?     @map("remote_snapshot")
  reconciliationStatus String?   @map("reconciliation_status")
  errorCode            String?   @map("error_code")
  errorMessage         String?   @map("error_message")
  reconciledAt         DateTime? @map("reconciled_at")
  reconciledByUserId   String?   @map("reconciled_by_user_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  order Order        @relation(fields: [orgId, orderId], references: [orgId, id], onDelete: Restrict)

  @@unique([orgId, orderId])
  @@unique([retailer, remoteInvoiceId])
  @@index([state, nextAttemptAt, leaseExpiresAt])
  @@index([orgId, state])
  @@map("kiotviet_invoice_jobs")
}

model ZaloAccountRateState {
  accountId   String      @id @map("account_id")
  dateVn      String      @map("date_vn") @db.VarChar(10)
  dailyCount  Int         @default(0) @map("daily_count")
