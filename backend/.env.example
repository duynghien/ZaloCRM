PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.com

# Security — generate strong 256-bit random keys using: openssl rand -hex 32
JWT_SECRET=generate_strong_64_char_random_hex_key_here
ENCRYPTION_KEY=generate_strong_64_char_random_hex_key_here

DATABASE_URL=postgresql://crmuser:password@localhost:5432/zalocrm
UPLOAD_DIR=/var/lib/zalo-crm/files
