# === Zalo Sales CRM ===
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.com

# Security — generate strong 256-bit random keys using: openssl rand -hex 32
JWT_SECRET=generate_strong_64_char_random_hex_key_here
ENCRYPTION_KEY=generate_strong_64_char_random_hex_key_here

# Database
DB_USER=crmuser
DB_PASSWORD=set_a_strong_database_password_here
DB_NAME=zalocrm
DATABASE_URL=postgresql://crmuser:set_a_strong_database_password_here@db:5432/zalocrm

# Storage
UPLOAD_DIR=/var/lib/zalo-crm/files

# AI Reports
# GEMINI_API_KEY=
# Stable Gemini model. Do not use retired gemini-2.0-* model IDs.
GEMINI_MODEL=gemini-3.6-flash
